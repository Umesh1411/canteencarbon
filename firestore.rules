rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'manager' || 
        getUserData().role == 'university_admin'
      );
    }

    // Users Collection: users can read and write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isManagerOrAdmin());
    }

    // Waste Entries Collection:
    // Any authenticated staff or manager can read entries
    // Kitchen staff and managers can create entries
    // Managers and Admins can delete entries
    match /wasteEntries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isManagerOrAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
